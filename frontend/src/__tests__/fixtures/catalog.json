    "specFields": {
        "cpuCores": {
            "label": "CPU cores",
            "type": "number",
            "min": 1,
            "max": 1024,
            "integer": true,
            "hint": "Leave blank if unsure"
        },
        "memoryGb": {
            "label": "Memory (RAM)",
            "type": "number",
            "unit": "GB",
            "min": 1,
            "max": 65536,
            "hint": "e.g. 16 for typical work, 64+ for heavy data work"
        },
        "storageGb": {
            "label": "Storage",
            "type": "number",
            "unit": "GB",
            "min": 1,
            "max": 10000000
        },
        "storageType": {
            "label": "Storage type",
            "type": "enum",
            "options": [
                "hdd",
                "ssd",
                "nvme"
            ]
        },
        "gpuModel": {
            "label": "GPU model",
            "type": "string",
            "maxLength": 100,
            "hint": "e.g. NVIDIA RTX 4090, or \"any CUDA-capable\""
        },
        "gpuCount": {
            "label": "Number of GPUs",
            "type": "number",
            "min": 1,
            "max": 64,
            "integer": true
        },
        "gpuMemoryGb": {
            "label": "GPU memory",
            "type": "number",
            "unit": "GB",
            "min": 1,
            "max": 4096
        },
        "operatingSystem": {
            "label": "Operating system",
            "type": "string",
            "maxLength": 100,
            "hint": "e.g. Windows 11, Ubuntu 22.04"
        },
        "formFactor": {
            "label": "Form factor",
            "type": "enum",
            "options": [
                "desktop",
                "laptop",
                "any"
            ]
        },
        "networkPorts": {
            "label": "Network ports",
            "type": "number",
            "min": 1,
            "max": 1024,
            "integer": true
        },
        "networkSpeedGbps": {
            "label": "Network speed",
            "type": "number",
            "unit": "Gbps",
            "min": 0.01,
            "max": 1000
        }
    },
