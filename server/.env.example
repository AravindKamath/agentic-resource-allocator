PORT=8080
MONGO_URI=mongodb://mongo:27017/helpdesk
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change-me-too
REFRESH_EXPIRES_IN=7d

# Agent worker
AGENT_BASE_URL=http://agent:9000
AGENT_TIMEOUT_MS=8000
AGENT_RETRY=2

# Defaults
AUTO_CLOSE_ENABLED=true
CONFIDENCE_THRESHOLD=0.78
SLA_HOURS=24

CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Gmail API (disabled unless explicitly enabled)
GMAIL_ENABLED=false
ADMIN_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/gmail/oauth/callback
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_WRITE_REFRESH_TOKEN=false
GMAIL_POLL_INTERVAL_MS=30000
GMAIL_LABEL=INBOX
